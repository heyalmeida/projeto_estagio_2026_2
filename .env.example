# Database (SQLite for local evaluation)
DATABASE_URL="file:./dev.db"

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-please-generate-a-real-secret-with-openssl-rand-base64-32"

# Trust the host in dev (required by NextAuth v5 behind proxies)
AUTH_TRUST_HOST="true"

