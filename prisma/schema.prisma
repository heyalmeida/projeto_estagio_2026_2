// Vestaply — Prisma schema
// Local SQLite for evaluation. Models kept minimal per the test brief:
// only `Admin` and `Demand` are required by prompt.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Demand {
  id                   String   @id @default(cuid())
  protocol             String   @unique
  buyerName            String
  email                String
  companyName          String
  category             String
  deliveryDate         DateTime
  quantity             Int
  sizeGrade            String
  // Target unit price stored as integer cents — never use floats for money.
  targetUnitPriceCents Int?
  notes                String?
  // Single source of truth for status — validated in domain layer.
  status               String   @default("pendente")
  internalNotes        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status])
  @@index([deliveryDate])
  @@index([createdAt])
  @@map("demands")
}